{
  "ConnectionStrings": {
    "Default": "Data Source=devdynamics.db"
  },

  "Cors": {
    "AllowedOrigins": [
      "https://devdynamics-frontend.onrender.com",
      "http://localhost:4200"
    ]
  },

  "Database": {
    "MaxRetryCount": 6,
    "MaxRetryDelaySeconds": 20,
    "CommandTimeoutSeconds": 60,
    "StartupWaitAttempts": 12,
    "StartupWaitIntervalSeconds": 10
  },

  "GitHub": {
    "//Token": "Supplied at runtime via the GitHub__Token environment variable. Never commit a token.",
    "ApiBaseUrl": "https://api.github.com/",
    "UserAgent": "DevDynamics-Analytics",
    "SyncWindowDays": 90,
    "MaxPagesPerResource": 20,
    "PageSize": 100,
    "RateLimitFloor": 100,
    "OverlapBufferMinutes": 60,
    "MaxRetries": 3,
    "RequestTimeoutSeconds": 30,
    "WriteBatchSize": 250
  },

  "Registry": {
    "//DemoRepositories": "Seeded only into a completely empty registry. Ordinary rows: removable and replaceable through the management API.",
    "DemoRepositories": [
      "chartjs/Chart.js",
      "ChilliCream/graphql-platform",
      "dotnet/efcore",
      "angular/components",
      "supabase/supabase",
      "moto23/Devdynamics_Analytics"
    ]
  },

  "Admin": {
    "//ApiKey": "Supplied at runtime via the Admin__ApiKey environment variable. Repository management fails closed when unset."
  },

  "Seed": {
    "//Enabled": "Legacy synthetic activity data, retired. Enable only to reproduce the Phase 2 query benchmark.",
    "Enabled": false,
    "RowCount": 25000
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  "AllowedHosts": "*"
}
