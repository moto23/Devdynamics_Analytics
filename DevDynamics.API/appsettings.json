{
  "ConnectionStrings": {
    "Default": "Data Source=devdynamics.db"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://devdynamics-frontend.onrender.com",
      "http://localhost:4200"
    ]
  },
  "Seed": {
    "Enabled": true
  },
  "GitHub": {
    "_comment": "Token is supplied at runtime via the GitHub__Token environment variable. Never commit a token.",
    "Repositories": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
